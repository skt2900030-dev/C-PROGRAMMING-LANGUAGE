#include <stdio.h>

int main() {
    int a,b;
    printf("ENTER THE VALUE OF a = ");
    scanf("%d",&a);
    printf("ENTER THE VALUE OF b = ");
    scanf("%d",&b);


    printf("a + b = %d\n", a + b);
    printf("a - b = %d\n", a - b);
    printf("a * b = %d\n", a * b);
    printf("a / b = %d\n", a / b);
    printf("a %% b = %d\n", a % b);

    return 0;
}
